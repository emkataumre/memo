# memo · environment variables (server-only)
#
# Copy to .env.local for local development. Set in Vercel for prod.
# NEVER use NEXT_PUBLIC_* prefixes — see tech-spec.md §2.

# Passphrase gate
MEMO_PASSPHRASE="change-me"
MEMO_SESSION_SECRET="generate-a-long-random-string-at-least-32-chars"

# Supabase (server-side access only)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Spotify Web API (Client Credentials flow, server-side)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
