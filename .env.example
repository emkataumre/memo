# memo · environment variables
#
# Copy to .env.local for local development. Set in Vercel for prod.
#
# Server-only vars (no NEXT_PUBLIC_ prefix): never exposed to the browser.
# NEXT_PUBLIC_* vars are inlined into the client bundle by Next.js. Only
# put here values that are safe to be public (the Supabase URL and anon
# key qualify by design — the security boundary is the passphrase gate
# + JWT-gated RLS, not key secrecy).

# Passphrase gate
MEMO_PASSPHRASE="change-me"
MEMO_SESSION_SECRET="generate-a-long-random-string-at-least-32-chars"

# Supabase (server-side access)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# JWT secret used to mint memo_session tokens accepted by Supabase RLS +
# Realtime. Copy from Supabase dashboard → Settings → API → JWT Secret.
SUPABASE_JWT_SECRET="copy-from-supabase-dashboard"

# Supabase (browser, public per Supabase design — RLS is the gate)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Spotify Web API (Client Credentials flow, server-side)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Web Push (VAPID). Generate once with:
#   npx web-push generate-vapid-keys --json
# Then paste public key into both VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY,
# and private key into VAPID_PRIVATE_KEY. The subject is shown to the push
# service in case they need to contact you (mailto: or https: URL).
VAPID_SUBJECT="mailto:you@example.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Shared secret for /api/push/send. Cron service POSTs to that route
# with X-Trigger-Secret: <this value> at ~21:00 Europe/Copenhagen.
# Mint with: openssl rand -hex 32   (or any ≥16-char random string)
PUSH_TRIGGER_SECRET=""
